{
  "expo": {
    "name": "Paco",
    "slug": "paco",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.programever.paco",
      "appleTeamId": "59TC22CESH"
    },
    "plugins": [
      "./plugins/withoutRemotePush",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Paco reads your position during a race, also when the screen is locked, to tell you how far the next checkpoint is and if you leave the route.",
          "locationWhenInUsePermission": "Paco reads your position to place you on the race route."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/use_poles.wav",
            "./assets/sounds/no_poles.wav",
            "./assets/sounds/km_5.wav",
            "./assets/sounds/km_4.wav",
            "./assets/sounds/km_3.wav",
            "./assets/sounds/km_2.wav",
            "./assets/sounds/km_1.wav",
            "./assets/sounds/off_route.wav",
            "./assets/sounds/crew_message.wav"
          ]
        }
      ]
    ],
    "backgroundColor": "#101823",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101823"
    }
  }
}
